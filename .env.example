# ────────────────────────────────────────────────────────────────────
#  Alpaca Paper Trading 凭证（本地运行需要）
# ────────────────────────────────────────────────────────────────────
#
#  用法：
#    1. 复制这个文件：cp .env.example .env
#    2. 去 https://app.alpaca.markets/paper/dashboard/overview 登陆
#       → 右侧 "Your API Keys" 块 → 点 "Generate New Key"
#       → Secret Key 只显示一次，立刻复制
#    3. 把下面两行的占位符替换成你的真 key
#    4. python check_setup.py  （验证配置）
#
#  注意：.env 已在 .gitignore 里，不会被 commit。千万别把 key 贴到聊天/代码/截图里。
#
# ────────────────────────────────────────────────────────────────────

ALPACA_API_KEY=PK_YOUR_KEY_ID_HERE
ALPACA_SECRET_KEY=YOUR_SECRET_KEY_HERE

# Paper 账户 API endpoint（正常情况下不用改）
ALPACA_BASE_URL=https://paper-api.alpaca.markets/v2

# 强制 paper 模式（安全默认）
PAPER_TRADING=true

# ────────────────────────────────────────────────────────────────
#  Claude AI 分析（可选）
#  去 https://console.anthropic.com/settings/keys 获取
# ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# ────────────────────────────────────────────────────────────────
#  Email 通知（可选）
#  Gmail 需要「应用专用密码」而不是账户密码
#  获取：Google账户 → 安全性 → 两步验证 → 应用专用密码
# ────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=YOUR_APP_PASSWORD_HERE
NOTIFY_EMAIL=your@gmail.com
